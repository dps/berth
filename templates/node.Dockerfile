# Generated by Berth for a Node.js app. Commit it as ./Dockerfile to customise.
FROM node:{{.NodeVersion}}-slim
WORKDIR /app
{{- if .Corepack}}
RUN corepack enable
{{- end}}
COPY package.json {{.LockFiles}} ./
RUN --mount=type=cache,target=/root/.npm --mount=type=cache,target=/root/.cache {{.InstallCmd}}
COPY . .
{{- if .BuildCmd}}
RUN {{.BuildCmd}}
{{- end}}
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
CMD {{.StartCmd}}
