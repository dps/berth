# berth.computer: a static site. Berth sets PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	@www host www.berth.computer
	redir @www https://berth.computer{uri} permanent

	respond /healthz 200

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	header /assets/* Cache-Control "public, max-age=3600"

	file_server
	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
